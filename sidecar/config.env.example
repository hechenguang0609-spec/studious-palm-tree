# REQUIRED: must match iPad Settings → General → About → Name
# Also must match what SidecarLauncher lists:  ./bin/SidecarLauncher devices
# DO NOT copy someone else's name. Wrong name → connect fails or targets the wrong device.
SIDECAR_DEVICE_NAME="Your iPad Name Here"

# Optional paths (defaults work if you install under ~/Scripts/sidecar)
# SIDECAR_HOME="$HOME/Scripts/sidecar"
# SIDECAR_LOG="/tmp/sidecar-autoconnect.log"
