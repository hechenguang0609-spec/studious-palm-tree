# REQUIRED — different iPads have different names. Do NOT copy another person's value.
# 1) On the iPad: Settings → General → About → Name
# 2) On the Mac:  ./bin/SidecarLauncher devices
# 3) Set the exact match below, then: cp config.env.example config.env
SIDECAR_DEVICE_NAME="Your iPad Name Here"

# Only if your iPad's About name is literally the generic word "iPad":
# SIDECAR_ALLOW_GENERIC_IPAD=1

# Also replace REPLACE_ME in LaunchAgents/*.plist with YOUR macOS username
# (the folder name under /Users/). Paths are machine-specific.
